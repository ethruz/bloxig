<%- include('../layout/header') %>

<div style="max-width:1100px;margin:0 auto;padding:48px 28px;">

  <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:40px;gap:16px;flex-wrap:wrap;">
    <div>
      <h1 style="font-size:var(--text-2xl);letter-spacing:-0.03em;margin-bottom:4px;">Projects</h1>
      <p style="font-size:var(--text-sm);color:var(--text-tertiary);">
        <%= user.email %>
        &nbsp;·&nbsp;
        <span style="color:<%= user.subscription_status === 'Pro' ? 'var(--accent)' : user.subscription_status === 'Lifetime' ? 'var(--gold)' : 'var(--text-disabled)' %>">
          <%= user.subscription_status %>
        </span>
        <% if (user.subscription_status === 'Free') { %>
          &nbsp;·&nbsp; <span style="color:var(--text-disabled);">3 project limit</span>
        <% } %>
      </p>
    </div>
    <% if (user.subscription_status === 'Free') { %>
      <a href="/#pricing" class="btn btn--accent">Upgrade to Pro</a>
    <% } %>
  </div>

  <div style="
    background:var(--bg-subtle);
    border:1px solid var(--border-faint);
    border-radius:var(--r-lg);
    padding:20px 24px;
    margin-bottom:32px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    flex-wrap:wrap;
  ">
    <div>
      <p style="font-size:var(--text-xs);color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:4px;">Your API Token</p>
      <p style="font-size:var(--text-xs);color:var(--text-secondary);">Use this in the Roblox Studio plugin and Figma plugin to authenticate.</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;">
      <code id="token-display" style="font-size:11px;background:var(--bg-elevated);border:1px solid var(--border-subtle);border-radius:var(--r-sm);padding:6px 10px;color:var(--text-tertiary);word-break:break-all;max-width:280px;display:inline-block;">
        ••••••••••••••••••••
      </code>
      <button onclick="fetchToken(event)" class="btn btn--ghost" style="height:30px;font-size:11px;padding:0 10px;">
        Reveal
      </button>
    </div>
  </div>

  <hr class="divider" style="margin-bottom:32px;" />

  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <h2 style="font-size:var(--text-base);font-weight:500;letter-spacing:-0.01em;">
      Your projects
      <span style="color:var(--text-disabled);font-weight:400;margin-left:8px;font-size:var(--text-sm);">
        <%= projects.length %><%= user.subscription_status === 'Free' ? '/3' : '' %>
      </span>
    </h2>
  </div>

  <% if (projects.length === 0) { %>

    <div style="
      border:1px dashed var(--border-base);
      border-radius:var(--r-lg);
      padding:64px 32px;
      text-align:center;
    ">
      <div style="width:40px;height:40px;border-radius:var(--r-md);background:var(--bg-elevated);border:1px solid var(--border-subtle);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <rect x="2" y="2" width="6" height="6" rx="1.5" fill="var(--text-tertiary)"/>
          <rect x="10" y="2" width="6" height="6" rx="1.5" fill="var(--text-tertiary)"/>
          <rect x="2" y="10" width="6" height="6" rx="1.5" fill="var(--text-tertiary)"/>
          <rect x="10" y="10" width="6" height="6" rx="1.5" fill="var(--text-tertiary)" opacity="0.4"/>
        </svg>
      </div>
      <p style="font-size:var(--text-base);color:var(--text-secondary);margin-bottom:6px;">No projects yet</p>
      <p style="font-size:var(--text-sm);color:var(--text-tertiary);max-width:340px;margin:0 auto 24px;line-height:1.6;">
        Export a Figma frame using the Bloxig plugin to create your first project.
      </p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
        <code style="font-size:var(--text-xs);">POST /api/export</code>
        <a href="/docs" class="btn btn--ghost" style="height:30px;font-size:12px;padding:0 12px;">Read the docs</a>
      </div>
    </div>

  <% } else { %>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px;">
      <% projects.forEach(function(project) { %>

        <div class="card card--interactive" id="project-<%= project._id %>" style="display:flex;flex-direction:column;gap:16px;">

          <div style="display:flex;align-items:center;gap:12px;">
            <div style="
              width:36px;height:36px;
              border-radius:var(--r-md);
              background:var(--accent-dim);
              border:1px solid var(--accent-border);
              display:flex;align-items:center;justify-content:center;
              flex-shrink:0;
            ">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <rect x="2" y="2" width="5" height="5" rx="1" fill="var(--accent)"/>
                <rect x="9" y="2" width="5" height="5" rx="1" fill="var(--accent)"/>
                <rect x="2" y="9" width="5" height="5" rx="1" fill="var(--accent)"/>
                <rect x="9" y="9" width="5" height="5" rx="1" fill="var(--accent)" opacity="0.4"/>
              </svg>
            </div>
            <div>
              <h3 style="font-size:var(--text-base);font-weight:500;letter-spacing:-0.02em;"><%= project.name %></h3>
              <p style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:2px;">
                Updated <%= new Date(project.updatedAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %>
              </p>
            </div>

            <!-- Delete button (pushed to the right) -->
            <button
              onclick="deleteProject('<%= project._id %>', '<%= project.name.replace(/'/g, "\\'") %>')"
              title="Delete project"
              style="
                margin-left:auto;flex-shrink:0;
                width:30px;height:30px;
                display:flex;align-items:center;justify-content:center;
                background:none;border:1px solid var(--border-base);
                border-radius:var(--r-sm);
                color:var(--text-tertiary);cursor:pointer;
                transition:all 150ms;
              "
              onmouseover="this.style.color='var(--danger)';this.style.borderColor='var(--danger)';"
              onmouseout="this.style.color='var(--text-tertiary)';this.style.borderColor='var(--border-base)';"
            >
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 3.5h10M5.5 3.5V2.5a1 1 0 011-1h1a1 1 0 011 1v1M3 3.5l.5 8a1 1 0 001 1h5a1 1 0 001-1l.5-8" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>

          <div style="background:var(--bg-elevated);border:1px solid var(--border-faint);border-radius:var(--r-sm);padding:10px 12px;">
            <p style="font-size:10px;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:4px;">Project ID — paste into Studio plugin</p>
            <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
              <code style="font-size:11px;color:var(--text-secondary);word-break:break-all;"><%= project._id %></code>
              <button
                onclick="copyToClipboard('<%= project._id %>', this)"
                style="
                  height:24px;padding:0 8px;
                  background:var(--bg-overlay);
                  border:1px solid var(--border-base);
                  border-radius:4px;
                  font-size:10px;color:var(--text-tertiary);
                  cursor:pointer;white-space:nowrap;
                  transition:all 150ms;
                "
              >Copy</button>
            </div>
          </div>

          <% if (project.figma_file_id) { %>
            <p style="font-size:var(--text-xs);color:var(--text-tertiary);">
              Figma file: <code><%= project.figma_file_id %></code>
            </p>
          <% } %>

        </div>

      <% }) %>
    </div>

  <% } %>

  <div style="margin-top:48px;">
    <h2 style="font-size:var(--text-base);font-weight:500;letter-spacing:-0.01em;margin-bottom:20px;">Quick start</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1px;background:var(--border-faint);border:1px solid var(--border-faint);border-radius:var(--r-lg);overflow:hidden;">

      <% [
        { step:'01', title:'Get your token', body:'Copy your API token above. You\'ll need it in both the Figma plugin and Roblox Studio plugin.' },
        { step:'02', title:'Export from Figma', body:'Select a frame in Figma, run the Bloxig plugin, paste your token, and click Export.' },
        { step:'03', title:'Import in Studio', body:'Open the Bloxig plugin in Roblox Studio. Paste your token + project ID, preview, then confirm.' }
      ].forEach(function(s) { %>
        <div style="background:var(--bg-base);padding:24px;display:flex;flex-direction:column;gap:10px;">
          <span style="font-size:10px;color:var(--text-tertiary);font-family:var(--font-mono);letter-spacing:0.08em;"><%= s.step %></span>
          <h3 style="font-size:var(--text-sm);font-weight:500;letter-spacing:-0.01em;"><%= s.title %></h3>
          <p style="font-size:var(--text-xs);color:var(--text-tertiary);line-height:1.7;"><%= s.body %></p>
        </div>
      <% }) %>

    </div>
  </div>

</div>

<script>
let cachedToken = null;

function fetchToken(e) {
  if (e) e.preventDefault();
  const displayElement = document.getElementById('token-display');
  const btn = e ? e.target : document.querySelector('button[onclick="fetchToken(event)"]');

  // If already unmasked, hide it back immediately
  if (displayElement.textContent !== '••••••••••••••••••••' && !displayElement.textContent.includes('POST')) {
    displayElement.textContent = '••••••••••••••••••••';
    btn.textContent = 'Reveal';
    return;
  }

  // Use local variable if it was already fetched once during this session
  if (cachedToken) {
    displayElement.textContent = cachedToken;
    btn.textContent = 'Hide';
    return;
  }

  displayElement.textContent = 'Fetching...';

  fetch('/api/token-reveal', { method: 'GET', credentials: 'include' })
    .then(r => {
      if (!r.ok) throw new Error('Unauthorized');
      return r.json();
    })
    .then(data => {
      if (data.token) {
        cachedToken = data.token;
        displayElement.textContent = data.token;
        btn.textContent = 'Hide';
      } else {
        throw new Error('No token found');
      }
    })
    .catch(() => {
      displayElement.textContent = '••••••••••••••••••••';
      btn.textContent = 'Reveal';
      if (window.showToast) window.showToast('Could not fetch token. Please try again.', 'error');
    });
}

function copyToClipboard(text, btn) {
  navigator.clipboard.writeText(text).then(function() {
    const orig = btn.textContent;
    btn.textContent = 'Copied!';
    btn.style.color = 'var(--success)';
    btn.style.borderColor = 'rgba(61,214,140,0.3)';
    setTimeout(function() {
      btn.textContent = orig;
      btn.style.color = '';
      btn.style.borderColor = '';
    }, 2000);
  });
}
</script>


<!-- Delete confirmation modal -->
<div id="deleteModal" style="
  position:fixed;inset:0;z-index:1000;
  display:none;align-items:center;justify-content:center;
  background:rgba(0,0,0,0.6);backdrop-filter:blur(2px);
  padding:20px;
">
  <div style="
    width:100%;max-width:380px;
    background:var(--bg-elevated);
    border:1px solid var(--border-base);
    border-radius:var(--r-lg);
    box-shadow:0 16px 48px rgba(0,0,0,0.5);
    padding:24px;
    animation:modalIn 160ms var(--ease);
  ">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
      <div style="
        width:36px;height:36px;flex-shrink:0;
        border-radius:50%;
        background:rgba(229,72,77,0.10);
        border:1px solid rgba(229,72,77,0.25);
        display:flex;align-items:center;justify-content:center;
      ">
        <svg width="16" height="16" viewBox="0 0 14 14" fill="none">
          <path d="M2 3.5h10M5.5 3.5V2.5a1 1 0 011-1h1a1 1 0 011 1v1M3 3.5l.5 8a1 1 0 001 1h5a1 1 0 001-1l.5-8" stroke="var(--danger)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div>
        <h3 style="font-size:var(--text-base);font-weight:500;letter-spacing:-0.02em;color:var(--text-primary);">Delete project</h3>
        <p style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:1px;">This action cannot be undone.</p>
      </div>
    </div>

    <p style="font-size:var(--text-sm);color:var(--text-secondary);line-height:1.5;margin-bottom:22px;">
      You're about to permanently delete <strong id="deleteProjectName" style="color:var(--text-primary);font-weight:500;"></strong>. Its Project ID will stop working in the Studio plugin.
    </p>

    <div style="display:flex;gap:8px;justify-content:flex-end;">
      <button type="button" id="deleteCancel" class="btn btn--ghost" style="height:36px;">Cancel</button>
      <button type="button" id="deleteConfirm" class="btn" style="height:36px;background:var(--danger);color:#fff;border-color:var(--danger);">Delete</button>
    </div>
  </div>
</div>

<!-- Toast notifications (on-brand replacement for native alerts) -->
<div id="toastHost" style="position:fixed;bottom:24px;right:24px;z-index:1100;display:flex;flex-direction:column;gap:10px;align-items:flex-end;pointer-events:none;"></div>

<style>
  @keyframes modalIn {
    from { opacity:0; transform:translateY(8px) scale(0.98); }
    to   { opacity:1; transform:translateY(0) scale(1); }
  }
  #deleteConfirm:hover { filter:brightness(1.08); }
  #deleteConfirm:disabled { opacity:0.6; cursor:not-allowed; }

  @keyframes toastIn  { from { opacity:0; transform:translateX(12px); } to { opacity:1; transform:translateX(0); } }
  @keyframes toastOut { from { opacity:1; transform:translateX(0); }   to { opacity:0; transform:translateX(12px); } }
  .toast {
    display:flex;align-items:center;gap:10px;
    min-width:220px;max-width:340px;
    padding:12px 14px;
    background:var(--bg-elevated);
    border:1px solid var(--border-base);
    border-radius:var(--r-md);
    box-shadow:0 10px 32px rgba(0,0,0,0.45);
    font-size:var(--text-sm);color:var(--text-secondary);
    animation:toastIn 180ms var(--ease);
    pointer-events:auto;
  }
  .toast--error   { border-left:2px solid var(--danger); }
  .toast--success { border-left:2px solid var(--success); }
  .toast__dot { width:8px;height:8px;border-radius:50%;flex-shrink:0; }
  .toast--error   .toast__dot { background:var(--danger); }
  .toast--success .toast__dot { background:var(--success); }
</style>

<script>
(function(){
  var modal       = document.getElementById('deleteModal');
  var nameEl      = document.getElementById('deleteProjectName');
  var cancelBtn   = document.getElementById('deleteCancel');
  var confirmBtn  = document.getElementById('deleteConfirm');
  var pendingId   = null;

  // On-brand toast (replaces native alert) — exposed on window for other scripts
  window.showToast = function(message, type){
    var host = document.getElementById('toastHost');
    if (!host) return;
    var t = document.createElement('div');
    t.className = 'toast toast--' + (type === 'success' ? 'success' : 'error');
    t.innerHTML = '<span class="toast__dot"></span><span></span>';
    t.querySelector('span:last-child').textContent = message;
    host.appendChild(t);
    setTimeout(function(){
      t.style.animation = 'toastOut 180ms var(--ease) forwards';
      setTimeout(function(){ t.remove(); }, 200);
    }, 3200);
  }

  // Called by each card's trash button
  window.deleteProject = function(id, name){
    pendingId = id;
    nameEl.textContent = '"' + name + '"';
    modal.style.display = 'flex';
    confirmBtn.disabled = false;
    confirmBtn.textContent = 'Delete';
  };

  function closeModal(){
    modal.style.display = 'none';
    pendingId = null;
  }

  cancelBtn.addEventListener('click', closeModal);
  // click outside the card closes it
  modal.addEventListener('click', function(e){ if (e.target === modal) closeModal(); });
  // Esc closes it
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && modal.style.display === 'flex') closeModal(); });

  confirmBtn.addEventListener('click', async function(){
    if (!pendingId) return;
    confirmBtn.disabled = true;
    confirmBtn.textContent = 'Deleting...';
    try {
      var res = await fetch('/dashboard/projects/' + pendingId + '/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      var data = await res.json();
      if (res.ok && data.success) {
        var card = document.getElementById('project-' + pendingId);
        showToast('Project deleted.', 'success');
        if (card) {
          card.style.transition = 'opacity 200ms';
          card.style.opacity = '0';
        }
        setTimeout(function(){ location.reload(); }, 320);
      } else {
        closeModal();
        showToast(data.error || 'Failed to delete project.', 'error');
      }
    } catch (e) {
      closeModal();
      showToast('Failed to delete project. Please try again.', 'error');
    }
  });
})();
</script>

<%- include('../layout/footer') %>