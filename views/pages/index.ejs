<%- include('../layout/header') %>

<!-- ═══════════════════════ HERO ════════════════════════════ -->
<section class="section--lg" style="padding-top:120px;padding-bottom:100px;text-align:center;position:relative;overflow:hidden;">

  <div aria-hidden="true" style="position:absolute;top:-120px;left:50%;transform:translateX(-50%);width:700px;height:500px;background:radial-gradient(ellipse,rgba(79,123,247,0.06) 0%,transparent 70%);pointer-events:none;"></div>

  <div class="container--sm" style="position:relative;">

    <a href="/docs" class="badge badge--accent" style="margin-bottom:32px;display:inline-flex;">
      <svg width="8" height="8" viewBox="0 0 8 8" fill="currentColor" style="flex-shrink:0;"><circle cx="4" cy="4" r="3"/></svg>
      22 Roblox GUI objects supported
    </a>

    <h1 style="font-size:clamp(36px,6vw,60px);font-weight:500;letter-spacing:-0.04em;line-height:1.08;color:var(--text-primary);margin-bottom:24px;">
      Design in Figma.<br>
      <span style="color:var(--text-secondary);">Ship in Roblox.</span>
    </h1>

    <p style="font-size:clamp(16px,2.5vw,19px);line-height:1.65;color:var(--text-secondary);max-width:480px;margin:0 auto 40px;font-weight:300;">
      Bloxig exports your Figma frames as structured JSON and rebuilds them as native Roblox GUI — preserving every script you've written.
    </p>

    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
      <a href="/auth/signup" class="btn btn--primary btn--xl">Start for free</a>
      <a href="/docs" class="btn btn--ghost btn--xl">Read the docs</a>
    </div>

    <p style="margin-top:20px;font-size:var(--text-xs);color:var(--text-tertiary);">
      No credit card required &nbsp;·&nbsp; 3 projects free
    </p>

  </div>
</section>

<!-- ═══════════════════════ STATS BAR ══════════════════════ -->
<div style="border-top:1px solid var(--border-faint);border-bottom:1px solid var(--border-faint);padding:24px 0;">
  <div class="container">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:24px;text-align:center;">
      <% [
        { value:'22', label:'GUI objects supported' },
        { value:'4-stop', label:'Anime gradient fidelity' },
        { value:'0', label:'Scripts deleted on merge' },
        { value:'100%', label:'Scale-based layout' },
      ].forEach(function(s) { %>
        <div>
          <p style="font-size:var(--text-2xl);font-weight:500;letter-spacing:-0.04em;color:var(--text-primary);"><%= s.value %></p>
          <p style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:4px;"><%= s.label %></p>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<!-- ═══════════════════════ SOUND FAMILIAR? ════════════════ -->
<section class="section" id="pain">
  <div class="container">

    <div style="max-width:480px;margin-bottom:48px;">
      <span class="eyebrow">Sound familiar?</span>
      <h2 style="font-size:clamp(24px,4vw,36px);letter-spacing:-0.03em;line-height:1.15;margin-bottom:12px;">
        Every Roblox developer has been here
      </h2>
      <p style="color:var(--text-secondary);font-size:var(--text-sm);line-height:1.7;">Real quotes from the Roblox developer forums.</p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;">
      <% [
        { quote:'Importing UI from Figma to Roblox takes FOREVER. I have a million frames left.', source:'Roblox DevForum' },
        { quote:'You\'re always going to do manual work to adjust fonts, colors, scaling, and aspect ratios after import.', source:'Roblox DevForum' },
        { quote:'The UI is blurry when imported using ImageLabel — it stretches when I try to fit it.', source:'Roblox DevForum' },
        { quote:'All the calculated distances are wrong, the UI elements have different heights. You spend more time fixing than designing.', source:'Roblox DevForum' },
        { quote:'It is currently too hard, frustrating, and time-consuming to import 2D objects from Figma to Roblox.', source:'Roblox Feature Request' },
        { quote:'Exporting individual elements isn\'t only time consuming — quality gets lost on bigger elements.', source:'Roblox DevForum' },
      ].forEach(function(item) { %>
        <div style="
          background:var(--bg-subtle);
          border:1px solid var(--border-faint);
          border-radius:var(--r-lg);
          padding:24px;
          display:flex;flex-direction:column;gap:12px;
        ">
          <p style="font-size:var(--text-sm);color:var(--text-secondary);line-height:1.7;flex:1;">
            "<%= item.quote %>"
          </p>
          <p style="font-size:var(--text-xs);color:var(--text-tertiary);">— <%= item.source %></p>
        </div>
      <% }) %>
    </div>

    <!-- Time comparison table -->
    <div style="margin-top:32px;border:1px solid var(--border-faint);border-radius:var(--r-lg);overflow:hidden;">
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;background:var(--bg-elevated);border-bottom:1px solid var(--border-faint);">
        <div style="padding:12px 20px;font-size:var(--text-xs);color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.08em;">Task</div>
        <div style="padding:12px 20px;font-size:var(--text-xs);color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.08em;border-left:1px solid var(--border-faint);">By hand</div>
        <div style="padding:12px 20px;font-size:var(--text-xs);color:var(--accent);text-transform:uppercase;letter-spacing:0.08em;border-left:1px solid var(--border-faint);">With Bloxig</div>
      </div>
      <% [
        ['Simple UI (few buttons)', '~2 hours', 'One import'],
        ['Complex UI (100+ instances)', 'Half a day', 'Under a minute'],
        ['Update after design change', 'Rebuild everything', 'Smart Merge'],
        ['Scale for different screens', 'Calculate UDim2 by hand', 'Automatic'],
      ].forEach(function(row, i) { %>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;border-top:1px solid var(--border-faint);">
          <div style="padding:14px 20px;font-size:var(--text-sm);color:var(--text-secondary);"><%= row[0] %></div>
          <div style="padding:14px 20px;font-size:var(--text-sm);color:var(--text-tertiary);border-left:1px solid var(--border-faint);"><%= row[1] %></div>
          <div style="padding:14px 20px;font-size:var(--text-sm);color:var(--success);border-left:1px solid var(--border-faint);"><%= row[2] %></div>
        </div>
      <% }) %>
    </div>

  </div>
</section>

<!-- ═══════════════════════ HOW IT WORKS ═══════════════════ -->
<section class="section" id="how-it-works">
  <div class="container">

    <div style="max-width:480px;margin-bottom:64px;">
      <span class="eyebrow">How it works</span>
      <h2 style="font-size:clamp(24px,4vw,36px);letter-spacing:-0.03em;line-height:1.15;margin-bottom:16px;">Three steps from design to production</h2>
      <p style="color:var(--text-secondary);font-size:var(--text-base);line-height:1.7;">No more manually recreating UI in Studio. Export once, sync forever.</p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1px;background:var(--border-faint);border:1px solid var(--border-faint);border-radius:var(--r-xl);overflow:hidden;">
      <% [
        { n:'01', title:'Select in Figma', body:'Run the Bloxig plugin inside Figma. Select any frame or component and export it as structured JSON with one click.' },
        { n:'02', title:'Sync to server', body:'Your layout is stored in your Bloxig account and versioned automatically. Copy the project ID from your dashboard.' },
        { n:'03', title:'Import in Studio', body:'Open the Bloxig plugin in Roblox Studio. Preview changes, then confirm. Smart Merge never overwrites your LocalScripts.' }
      ].forEach(function(step) { %>
        <div style="background:var(--bg-base);padding:32px;display:flex;flex-direction:column;gap:16px;">
          <div style="display:flex;align-items:center;gap:12px;">
            <span style="font-size:var(--text-xs);font-weight:500;color:var(--text-tertiary);font-family:var(--font-mono);"><%= step.n %></span>
            <div style="height:1px;flex:1;background:var(--border-faint);"></div>
          </div>
          <h3 style="font-size:var(--text-lg);letter-spacing:-0.02em;"><%= step.title %></h3>
          <p style="color:var(--text-secondary);font-size:var(--text-sm);line-height:1.7;"><%= step.body %></p>
        </div>
      <% }) %>
    </div>

  </div>
</section>

<!-- ═══════════════════════ SMART MERGE ════════════════════ -->
<section class="section--sm">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;border:1px solid var(--border-faint);border-radius:var(--r-xl);padding:56px;background:var(--bg-subtle);">
      <div>
        <div class="badge badge--success" style="margin-bottom:20px;">
          <svg width="6" height="6" viewBox="0 0 6 6" fill="currentColor"><circle cx="3" cy="3" r="3"/></svg>
          Smart Merge
        </div>
        <h2 style="font-size:clamp(22px,3.5vw,32px);letter-spacing:-0.03em;line-height:1.2;margin-bottom:16px;">Re-import without destroying your work</h2>
        <p style="color:var(--text-secondary);font-size:var(--text-base);line-height:1.7;margin-bottom:24px;">
          Every element carries a unique <code>Figblox_ID</code>. On re-import, Bloxig diffs by ID — updating visuals while leaving your scripts completely untouched.
        </p>
        <ul style="display:flex;flex-direction:column;gap:10px;">
          <% ['Updates properties, never deletes children','LocalScript and ModuleScript safe','Orphaned elements flagged, not removed'].forEach(function(item){ %>
            <li style="display:flex;align-items:flex-start;gap:10px;font-size:var(--text-sm);color:var(--text-secondary);">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="flex-shrink:0;margin-top:2px;"><circle cx="8" cy="8" r="7" stroke="rgba(61,214,140,0.3)" stroke-width="1"/><path d="M5 8l2 2 4-4" stroke="#3dd68c" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <%= item %>
            </li>
          <% }) %>
        </ul>
      </div>
      <div style="background:var(--bg-elevated);border:1px solid var(--border-subtle);border-radius:var(--r-lg);padding:24px;font-family:var(--font-mono);font-size:var(--text-xs);line-height:1.9;color:var(--text-tertiary);">
        <div style="color:var(--text-disabled);margin-bottom:12px;font-size:10px;">SmartMerge.lua</div>
        <div><span style="color:#7aa2f7;">local</span> existing = findByID(node.id)</div>
        <div><span style="color:#7aa2f7;">if</span> existing <span style="color:#7aa2f7;">then</span></div>
        <div style="padding-left:16px;color:var(--text-secondary);">update(Position, Size, Color)</div>
        <div style="padding-left:16px;color:var(--success);">-- scripts preserved ✓</div>
        <div><span style="color:#7aa2f7;">else</span></div>
        <div style="padding-left:16px;color:var(--text-secondary);">createElement(node)</div>
        <div><span style="color:#7aa2f7;">end</span></div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════ PRICING ════════════════════════ -->
<section class="section" id="pricing">
  <div class="container">
    <div style="text-align:center;max-width:480px;margin:0 auto 64px;">
      <span class="eyebrow">Pricing</span>
      <h2 style="font-size:clamp(24px,4vw,36px);letter-spacing:-0.03em;line-height:1.15;">Simple, transparent pricing</h2>
      <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-top:12px;">Start free. Upgrade when you need more.</p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;max-width:920px;margin:0 auto;align-items:start;">

      <!-- FREE -->
      <div class="pricing-card">
        <div>
          <p style="font-size:var(--text-sm);font-weight:500;color:var(--text-secondary);margin-bottom:8px;">Free</p>
          <p style="font-size:40px;font-weight:500;letter-spacing:-0.04em;line-height:1;">$0</p>
          <p style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:6px;">Forever, no card needed</p>
        </div>
        <ul style="display:flex;flex-direction:column;gap:10px;flex:1;">
          <% ['3 active projects','Figma JSON export','Roblox import','22 GUI objects','Community support'].forEach(function(f){ %>
            <li style="display:flex;align-items:center;gap:8px;font-size:var(--text-sm);color:var(--text-secondary);">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7l2.5 2.5L11 4.5" stroke="var(--text-tertiary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <%= f %>
            </li>
          <% }) %>
        </ul>
        <a href="/auth/signup" class="btn btn--ghost btn--full" style="height:42px;">Get started free</a>
      </div>

      <!-- PRO -->
      <div class="pricing-card pricing-card--accent">
        <div>
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
            <p style="font-size:var(--text-sm);font-weight:500;color:var(--text-secondary);">Pro</p>
            <span class="badge badge--accent">Most popular</span>
          </div>
          <p style="font-size:40px;font-weight:500;letter-spacing:-0.04em;line-height:1;">$12</p>
          <p style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:6px;">Per month, cancel anytime</p>
        </div>
        <ul style="display:flex;flex-direction:column;gap:10px;flex:1;">
          <% ['Unlimited projects','Priority sync','Marketplace downloads','Smart Merge history','Import preview [+][~][=]','Email support'].forEach(function(f){ %>
            <li style="display:flex;align-items:center;gap:8px;font-size:var(--text-sm);color:var(--text-secondary);">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7l2.5 2.5L11 4.5" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <%= f %>
            </li>
          <% }) %>
        </ul>
        <a href="/auth/signup" class="btn btn--accent btn--full" style="height:42px;">Start free trial</a>
      </div>

      <!-- PRO PLUS LIFETIME -->
      <div class="pricing-card pricing-card--gold">
        <div>
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
            <p style="font-size:var(--text-sm);font-weight:500;color:var(--text-secondary);">Pro Plus</p>
            <span class="badge badge--gold">Lifetime</span>
          </div>
          <p style="font-size:40px;font-weight:500;letter-spacing:-0.04em;line-height:1;">$49</p>
          <p style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:6px;">One-time, yours forever</p>
        </div>
        <ul style="display:flex;flex-direction:column;gap:10px;flex:1;">
          <% ['Everything in Pro','Lifetime updates','Early feature access','Priority support','Figma file sync (coming)','Marketplace seller access'].forEach(function(f){ %>
            <li style="display:flex;align-items:center;gap:8px;font-size:var(--text-sm);color:var(--text-secondary);">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7l2.5 2.5L11 4.5" stroke="var(--gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <%= f %>
            </li>
          <% }) %>
        </ul>
        <a href="/auth/signup" class="btn btn--gold btn--full" style="height:42px;">Get lifetime access</a>
      </div>

    </div>

    <p style="text-align:center;margin-top:32px;font-size:var(--text-xs);color:var(--text-tertiary);">
      All plans include a 7-day money-back guarantee &nbsp;·&nbsp; Secure payment via Lemon Squeezy
    </p>

  </div>
</section>

<!-- ═══════════════════════ BOTTOM CTA ═════════════════════ -->
<section class="section--sm">
  <div class="container">
    <div style="text-align:center;padding:80px 40px;border:1px solid var(--border-faint);border-radius:var(--r-xl);background:var(--bg-subtle);">
      <h2 style="font-size:clamp(24px,4vw,40px);letter-spacing:-0.03em;margin-bottom:16px;">Stop rebuilding UI by hand.</h2>
      <p style="color:var(--text-secondary);font-size:var(--text-base);max-width:400px;margin:0 auto 32px;line-height:1.7;">Join Roblox developers shipping faster with Bloxig.</p>
      <a href="/auth/signup" class="btn btn--primary btn--xl">Create a free account</a>
    </div>
  </div>
</section>

<%- include('../layout/footer') %>
