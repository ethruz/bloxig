<%- include('../layout/header') %>

<section style="min-height:calc(100vh - 56px);display:flex;align-items:center;justify-content:center;padding:48px 20px;">
  <div style="width:100%;max-width:380px;">

    <div style="margin-bottom:32px;">
      <h1 style="font-size:var(--text-2xl);letter-spacing:-0.03em;margin-bottom:6px;">Welcome back</h1>
      <p style="font-size:var(--text-sm);color:var(--text-secondary);">Sign in to your Bloxig account.</p>
    </div>

    <form action="/auth/login" method="POST" style="display:flex;flex-direction:column;gap:16px;">

      <div class="form-field">
        <label class="form-label" for="email">Email</label>
        <input class="form-input" type="email" id="email" name="email"
          placeholder="you@example.com" required autocomplete="email" />
      </div>

      <div class="form-field">
        <label class="form-label" for="password">Password</label>
        <div style="position:relative;">
          <input class="form-input" type="password" id="password" name="password"
            placeholder="••••••••" required autocomplete="current-password"
            style="width:100%;padding-right:44px;" />
          <button type="button" id="togglePass" aria-label="Show password"
            style="position:absolute;right:8px;top:50%;transform:translateY(-50%);display:flex;align-items:center;justify-content:center;width:28px;height:28px;background:none;border:none;cursor:pointer;color:var(--text-tertiary);padding:0;transition:color 160ms;"
            onmouseover="this.style.color='var(--text-secondary)'" onmouseout="this.style.color='var(--text-tertiary)'">
            <!-- eye (password hidden) -->
            <svg id="eyeOpen" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            <!-- eye-off (password shown) -->
            <svg id="eyeOff" class="is-hidden" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
          </button>
        </div>
        <a href="/auth/forgot" style="font-size:var(--text-xs);color:var(--text-tertiary);text-decoration:none;align-self:flex-start;margin-top:6px;transition:color 160ms;"
           onmouseover="this.style.color='var(--text-secondary)'" onmouseout="this.style.color='var(--text-tertiary)'">Forgot password?</a>
      </div>

      <button type="submit" class="btn btn--primary btn--full" style="height:42px;margin-top:4px;">
        Sign in
      </button>

    </form>

    <p style="margin-top:24px;font-size:var(--text-sm);color:var(--text-tertiary);text-align:center;">
      Don't have an account?
      <a href="/auth/signup" style="color:var(--text-secondary);text-decoration:underline;text-underline-offset:3px;">Create one free</a>
    </p>

  </div>
</section>

<!-- Force-hide override: global.css sets `svg { display:block }`, which beats the
     [hidden] attribute. This class wins so only ONE eye shows at a time. -->
<style>
  .is-hidden { display: none !important; }
</style>

<script>
(function () {
  var toggleBtn = document.getElementById('togglePass');
  var passInput = document.getElementById('password');
  var eyeOpen   = document.getElementById('eyeOpen');
  var eyeOff    = document.getElementById('eyeOff');
  if (toggleBtn && passInput) {
    toggleBtn.addEventListener('click', function () {
      var showing = passInput.type === 'text';
      if (showing) {
        passInput.type = 'password';
        eyeOpen.classList.remove('is-hidden');
        eyeOff.classList.add('is-hidden');
        toggleBtn.setAttribute('aria-label', 'Show password');
      } else {
        passInput.type = 'text';
        eyeOpen.classList.add('is-hidden');
        eyeOff.classList.remove('is-hidden');
        toggleBtn.setAttribute('aria-label', 'Hide password');
      }
    });
  }
})();
</script>

<%- include('../layout/footer') %>
