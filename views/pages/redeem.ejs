<%- include('../layout/header') %>

<div style="max-width:560px;margin:0 auto;padding:64px 28px;">

  <div style="margin-bottom:32px;">
    <h1 style="font-size:var(--text-2xl);letter-spacing:-0.03em;margin-bottom:6px;">Redeem a code</h1>
    <p style="font-size:var(--text-sm);color:var(--text-secondary);">
      Have a promo or voucher code? Enter it below to unlock your plan.
    </p>
  </div>

  <% if (user.voucherUsed) { %>
    <div style="background:rgba(61,214,140,0.06);border:1px solid rgba(61,214,140,0.2);border-radius:var(--r-md);padding:16px 18px;font-size:var(--text-sm);color:var(--success);">
      You have already redeemed a voucher on this account: <code><%= user.voucherUsed %></code>
    </div>
    <p style="margin-top:16px;font-size:var(--text-sm);color:var(--text-tertiary);">
      Current plan: <strong style="color:var(--text-secondary);"><%= user.subscription_status %></strong>.
      <a href="/profile/billing" style="color:var(--accent);text-decoration:underline;text-underline-offset:3px;">View billing</a>
    </p>
  <% } else { %>
    <form action="/profile/voucher" method="POST" style="display:flex;flex-direction:column;gap:14px;">
      <div class="form-field">
        <label class="form-label" for="voucherCode">Voucher code</label>
        <input class="form-input" type="text" id="voucherCode" name="voucherCode"
          placeholder="e.g. BLOXIG2026" maxlength="30" autocomplete="off"
          style="text-transform:uppercase;letter-spacing:0.05em;" />
      </div>
      <button type="submit" class="btn btn--primary" style="height:42px;width:fit-content;">
        Redeem code
      </button>
    </form>

    <div style="margin-top:32px;padding-top:24px;border-top:1px solid var(--border-faint);">
      <p style="font-size:var(--text-xs);color:var(--text-tertiary);line-height:1.7;">
        Codes are case-insensitive and can be redeemed once per account.
        Looking to upgrade without a code?
        <a href="/#pricing" style="color:var(--accent);text-decoration:underline;text-underline-offset:3px;">See plans</a>.
      </p>
    </div>
  <% } %>

</div>

<%- include('../layout/footer') %>
