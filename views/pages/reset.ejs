<%- include('../layout/header') %>

<section style="min-height:calc(100vh - 56px);display:flex;align-items:center;justify-content:center;padding:48px 20px;">
  <div style="width:100%;max-width:380px;">

    <div style="margin-bottom:32px;">
      <h1 style="font-size:var(--text-2xl);letter-spacing:-0.03em;margin-bottom:6px;">Set a new password</h1>
      <p style="font-size:var(--text-sm);color:var(--text-secondary);">Choose a strong password for your account.</p>
    </div>

    <% if (error) { %>
      <div style="background:rgba(229,72,77,0.10);border:1px solid rgba(229,72,77,0.25);color:#ff8086;font-size:var(--text-sm);padding:10px 14px;border-radius:var(--r-md);margin-bottom:16px;"><%= error %></div>
    <% } %>

    <form action="/auth/reset/<%= token %>" method="POST" style="display:flex;flex-direction:column;gap:16px;">

      <div class="form-field">
        <label class="form-label" for="password">New password</label>
        <div style="position:relative;">
          <input class="form-input" type="password" id="password" name="password"
            placeholder="••••••••" required autocomplete="new-password"
            style="width:100%;padding-right:44px;" />
          <button type="button" id="togglePass" aria-label="Show password"
            style="position:absolute;right:8px;top:50%;transform:translateY(-50%);display:flex;align-items:center;justify-content:center;width:28px;height:28px;background:none;border:none;cursor:pointer;color:var(--text-tertiary);padding:0;transition:color 160ms;"
            onmouseover="this.style.color='var(--text-secondary)'" onmouseout="this.style.color='var(--text-tertiary)'">
            <svg id="eyeOpen" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            <svg id="eyeOff" class="is-hidden" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
          </button>
        </div>
      </div>

      <div class="form-field">
        <label class="form-label" for="confirmPassword">Confirm new password</label>
        <input class="form-input" type="password" id="confirmPassword" name="confirmPassword"
          placeholder="••••••••" required autocomplete="new-password" />
      </div>

      <p style="font-size:var(--text-xs);color:var(--text-tertiary);line-height:1.5;">
        8–20 characters, with uppercase, lowercase, a number, and a symbol.
      </p>

      <button type="submit" class="btn btn--primary btn--full" style="height:42px;margin-top:4px;">Reset password</button>
    </form>

  </div>
</section>

<script>
  (function(){
    var btn = document.getElementById('togglePass');
    var input = document.getElementById('password');
    var eyeOpen = document.getElementById('eyeOpen');
    var eyeOff  = document.getElementById('eyeOff');
    if (btn) btn.addEventListener('click', function(){
      var show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      eyeOpen.classList.toggle('is-hidden', show);
      eyeOff.classList.toggle('is-hidden', !show);
    });
  })();
</script>

<%- include('../layout/footer') %>
