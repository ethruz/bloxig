<div class="card card--interactive" style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">

  <!-- Preview thumbnail -->
  <div style="
    height: 144px;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border-faint);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  ">
    <% if (asset.preview_url) { %>
      <img src="<%= asset.preview_url %>" alt="<%= asset.name %> preview" style="width: 100%; height: 100%; object-fit: cover;" />
    <% } else { %>
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <rect x="4" y="4" width="9" height="9" rx="2" fill="var(--border-base)"/>
        <rect x="15" y="4" width="9" height="9" rx="2" fill="var(--border-base)"/>
        <rect x="4" y="15" width="9" height="9" rx="2" fill="var(--border-base)"/>
        <rect x="15" y="15" width="9" height="9" rx="2" fill="var(--border-faint)"/>
      </svg>
    <% } %>
  </div>

  <!-- Info -->
  <div style="padding: 16px; display: flex; flex-direction: column; gap: 10px; flex: 1;">

    <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 8px;">
      <h3 style="font-size: var(--text-sm); font-weight: 500; letter-spacing: -0.01em; line-height: 1.3;"><%= asset.name %></h3>
      <% if (asset.isPro) { %>
        <span class="badge badge--accent" style="flex-shrink: 0; font-size: 10px;">Pro</span>
      <% } %>
    </div>

    <p style="font-size: var(--text-xs); color: var(--text-tertiary);"><%= asset.category %></p>

    <div style="display: flex; align-items: center; justify-content: space-between; margin-top: auto;">
      <span style="font-size: var(--text-base); font-weight: 500; letter-spacing: -0.02em; color: var(--text-primary);">
        $<%= (asset.price / 100).toFixed(2) %>
      </span>
      <a href="#" class="btn btn--ghost" style="height: 30px; padding: 0 12px; font-size: 12px;">Buy</a>
    </div>

  </div>

</div>
